<UserControl
    x:Class="EdgeAI_ObjectDetection.Controls.YoloInferenceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="Viewport" SizeChanged="Viewport_SizeChanged">
            <Canvas x:Name="PreviewSurface">
                <MediaPlayerElement x:Name="CameraPreview"
                    AreTransportControlsEnabled="False" AutoPlay="False" Stretch="Uniform" />
                <Image x:Name="StillFrame" Stretch="Uniform" />
            </Canvas>
            <Canvas x:Name="Overlay" IsHitTestVisible="False" />
        </Grid>
        <StackPanel Grid.Row="1" Margin="5">
            <TextBlock x:Name="StatusText" Text="Not running." TextWrapping="Wrap" />
            <TextBlock x:Name="TimingText" />
            <TextBlock x:Name="EndToEndTimingText" />
        </StackPanel>
    </Grid>
</UserControl>
