<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the main project's Windows TFM to resolve WinRT + ONNX types via the project reference. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Disable MSIX packaging when building the main project as a test dependency. -->
    <ProjectReference Include="..\EdgeAIKiosk1\EdgeAIKiosk1.csproj">
      <AdditionalProperties>EnableMsixTooling=false;AppxPackage=false;GenerateAppxPackageOnBuild=false</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
