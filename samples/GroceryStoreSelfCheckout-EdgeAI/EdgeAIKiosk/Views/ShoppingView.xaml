<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EdgeAIKiosk.Views.ShoppingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Windows Mart — Shopping">

    <Grid
        Background="{StaticResource KioskPrimaryBrush}"
        Padding="{StaticResource KioskPagePadding}"
        Loaded="OnShoppingViewLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Background="{StaticResource KioskBlackBrush}"
            CornerRadius="{StaticResource KioskPanelCornerRadius}">
            <ContentControl x:Name="LiveInferenceHost" />
        </Border>
        <Button
            Grid.Row="1"
            Grid.Column="0"
            x:Name="VoidItemButton"
            Content="Void Item"
            FontSize="{StaticResource KioskFontSizeButton}"
            Background="{StaticResource KioskDangerBrush}"
            Padding="{StaticResource KioskActionButtonPadding}"
            Margin="{StaticResource KioskBottomActionMargin}"
            HorizontalAlignment="Stretch"
            Style="{StaticResource KioskControlButtonStyle}"
            Click="OnVoidItemClick" />

        <ListBox
            Grid.Row="0"
            Grid.Column="2"
            x:Name="ScannedItemsListBox"
            Style="{StaticResource KioskScannedItemsListStyle}" />
        <Button
            Grid.Row="1"
            Grid.Column="2"
            x:Name="PayNowButton"
            Content="Pay Now"
            FontSize="{StaticResource KioskFontSizeButton}"
            Background="{StaticResource KioskSuccessBrush}"
            Padding="{StaticResource KioskActionButtonPadding}"
            Margin="{StaticResource KioskBottomActionMargin}"
            HorizontalAlignment="Stretch"
            Style="{StaticResource KioskControlButtonStyle}"
            Click="OnPayNowClick" />

        <TextBox
            x:Name="BarcodeInputBox"
            IsTabStop="True"
            Opacity="0"
            Width="20"
            Height="10"
            KeyDown="OnBarcodeKeyDown" />

        <Grid
            x:Name="LoadingOverlay"
            Grid.ColumnSpan="3"
            Canvas.ZIndex="10"
            Background="{StaticResource KioskLoadingOverlayBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource KioskSpacingLarge}">
                <ProgressRing
                    x:Name="LoadingProgressRing"
                    Width="72"
                    Height="72"
                    IsIndeterminate="True"
                    Background="{StaticResource KioskProgressBrush}" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    Text="Loading model..."
                    FontSize="{StaticResource KioskFontSizeSubtitle}"
                    Style="{StaticResource KioskWhiteSemiBoldTextStyle}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
