<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EdgeAIKiosk.Views.ShoppingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EdgeAIKiosk.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        Background="{StaticResource KioskPrimaryBrush}"
        Padding="{StaticResource KioskPagePadding}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="3"
            Text="Windows Mart - Scan items"
            FontSize="{StaticResource KioskFontSizeTitle}"
            Margin="{StaticResource KioskHeaderMargin}"
            Style="{StaticResource KioskWhiteBoldTextStyle}" />

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{StaticResource KioskBlackBrush}"
            CornerRadius="{StaticResource KioskPanelCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="LiveInferenceHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                <TextBlock x:Name="DetectedCountTextBlock"
                           Grid.Row="1"
                           Text="Detected: waiting for inference"
                           Margin="4"
                           Style="{StaticResource KioskWhiteSemiBoldTextStyle}" />
            </Grid>
        </Border>
        <Button
            Grid.Row="2"
            Grid.Column="0"
            x:Name="VoidItemButton"
            Content="Void Item"
            FontSize="{StaticResource KioskFontSizeButton}"
            Background="{StaticResource KioskDangerBrush}"
            Padding="{StaticResource KioskActionButtonPadding}"
            Margin="{StaticResource KioskBottomActionMargin}"
            HorizontalAlignment="Stretch"
            Style="{StaticResource KioskControlButtonStyle}"
            Click="OnVoidItemClick" />

        <Border
            Grid.Row="1"
            Grid.Column="2"
            Background="{StaticResource KioskBlackBrush}"
            CornerRadius="{StaticResource KioskPanelCornerRadius}">
            <ListBox
                x:Name="ScannedItemsListBox"
                Style="{StaticResource KioskScannedItemsListStyle}"
                Margin="0,50,0,0" />
        </Border>
        
        <TextBox
            Grid.Row="1"
            Grid.Column="2"
            x:Name="BarcodeInputBox"
            PlaceholderText="Type item name and press Enter..."
            VerticalAlignment="Top"
            FontSize="18"
            Margin="0,4,0,0"
            Visibility="{x:Bind BarcodeInputVisibility}" />
        <Button
            Grid.Row="2"
            Grid.Column="2"
            x:Name="PayNowButton"
            IsEnabled="False"
            Content="Pay Now"
            FontSize="{StaticResource KioskFontSizeButton}"
            Background="{StaticResource KioskSuccessBrush}"
            Padding="{StaticResource KioskActionButtonPadding}"
            Margin="{StaticResource KioskBottomActionMargin}"
            HorizontalAlignment="Stretch"
            Style="{StaticResource KioskControlButtonStyle}"
            Click="OnPayNowClick" />

        <Grid
            x:Name="LoadingOverlay"
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Background="{StaticResource KioskLoadingOverlayBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource KioskSpacingLarge}">
                <ProgressRing
                    x:Name="LoadingProgressRing"
                    Width="72"
                    Height="72"
                    IsIndeterminate="True"
                    Background="{StaticResource KioskProgressBrush}" />
                <TextBlock
                    x:Name="LoadingTextBlock"
                    Text="Loading model..."
                    FontSize="{StaticResource KioskFontSizeSubtitle}"
                    Style="{StaticResource KioskWhiteSemiBoldTextStyle}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <views:ErrorOverlay
            x:Name="ErrorView"
            Grid.RowSpan="3"
            Grid.ColumnSpan="3"
            Visibility="Collapsed"
            BackToHomeRequested="OnBackToHomeRequested" />
    </Grid>
</Page>
