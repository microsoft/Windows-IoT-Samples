<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EdgeAIKiosk.Views.AlertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EdgeAIKiosk.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource KioskPrimaryBrush}">

    <Grid>
        <Grid x:Name="SuccessPanel" Background="{StaticResource KioskSuccessBrush}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource KioskSpacingHero}">
                <TextBlock
                    Text="Thank you for shopping with us!"
                    FontSize="{StaticResource KioskFontSizeSuccess}"
                    Style="{StaticResource KioskWhiteBoldTextStyle}"
                    HorizontalAlignment="Center" />
                <Button
                    Content="Start Again"
                    FontSize="{StaticResource KioskFontSizeBodyLarge}"
                    Background="{StaticResource KioskPrimaryBrush}"
                    Padding="{StaticResource KioskHeroButtonPadding}"
                    HorizontalAlignment="Center"
                    CornerRadius="{StaticResource KioskPanelCornerRadius}"
                    Style="{StaticResource KioskWhiteButtonStyle}"
                    Click="OnBackToHomeRequested" />
            </StackPanel>
        </Grid>

        <Grid
            x:Name="FailurePanel"
            Background="{StaticResource KioskFailureBrush}"
            Padding="{StaticResource KioskPagePadding}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Text="Alert: Basket Mismatch Detected"
                FontSize="{StaticResource KioskFontSizeTitle}"
                Margin="{StaticResource KioskHeaderMargin}"
                Style="{StaticResource KioskWhiteBoldTextStyle}" />
            
            <Button
                Grid.Row="0" Grid.Column="2"
                Content="Back to Home"
                FontSize="{StaticResource KioskFontSizeSmall}"
                Background="{StaticResource KioskBlackBrush}"
                Padding="{StaticResource KioskBackButtonPadding}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Style="{StaticResource KioskControlButtonStyle}"
                Click="OnBackToHomeRequested" />

            <Border
                Grid.Row="2"
                Grid.Column="0"
                Background="{StaticResource KioskBlackBrush}"
                CornerRadius="{StaticResource KioskPanelCornerRadius}">
                <ContentControl
                    x:Name="LiveInferenceHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"/>
             </Border>

            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,10"
                Text="Mismatched items"
                FontSize="{StaticResource KioskFontSizeSubtitle}"
                Style="{StaticResource KioskWhiteBoldTextStyle}" />
            <ListView
                Grid.Row="2"
                Grid.Column="2"
                x:Name="MismatchedItemsListView"
                Style="{StaticResource KioskMismatchListStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Text="{Binding}"
                            Foreground="{StaticResource KioskErrorBrush}"
                            FontSize="{StaticResource KioskFontSizeBodyLarge}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <views:ErrorOverlay
            x:Name="ErrorView"
            Visibility="Collapsed"
            BackToHomeRequested="OnBackToHomeRequested" />
    </Grid>
</Page>
