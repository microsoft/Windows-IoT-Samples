<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EdgeAIKiosk.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{StaticResource KioskPrimaryBrush}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource KioskSpacingHero}">
            <TextBlock
                Text="Welcome To Windows Mart"
                FontSize="{StaticResource KioskFontSizeHero}"
                Style="{StaticResource KioskWhiteBoldTextStyle}"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Name="StartupErrorTextBlock"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                TextAlignment="Center"
                MaxWidth="640"
                FontSize="{StaticResource KioskFontSizeLabel}"
                Foreground="{StaticResource KioskWhiteBrush}" />
            <Button
                x:Name="StartNowButton"
                Content="Start Now"
                IsEnabled="False"
                FontSize="{StaticResource KioskFontSizeSubtitle}"
                Background="{StaticResource KioskSuccessBrush}"
                Padding="{StaticResource KioskLargeButtonPadding}"
                HorizontalAlignment="Center"
                CornerRadius="{StaticResource KioskPanelCornerRadius}"
                Style="{StaticResource KioskWhiteButtonStyle}"
                Click="OnStartNowClick" />
        </StackPanel>
        <Button
            x:Name="SettingsButton"
            Width="52"
            Height="52"
            Margin="{StaticResource KioskPagePadding}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{StaticResource KioskNeutralBrush}"
            CornerRadius="{StaticResource KioskRoundCornerRadius}"
            AutomationProperties.Name="Settings"
            Style="{StaticResource KioskWhiteForegroundButtonStyle}">
            <Button.Flyout>
                <Flyout x:Name="SettingsFlyout" Placement="TopEdgeAlignedRight">
                    <Flyout.FlyoutPresenterStyle>
                        <Style TargetType="FlyoutPresenter">
                            <Setter Property="Background" Value="{StaticResource KioskPanelBrush}" />
                            <Setter Property="Padding" Value="{StaticResource KioskPanelPadding}" />
                            <Setter Property="CornerRadius" Value="{StaticResource KioskPanelCornerRadius}" />
                            <Setter Property="MaxWidth" Value="500" />
                        </Style>
                    </Flyout.FlyoutPresenterStyle>
                    <StackPanel Width="420" Spacing="{StaticResource KioskSpacingLarge}">
                        <StackPanel Spacing="{StaticResource KioskSpacingSmall}">
                            <TextBlock
                                Text="Scanner"
                                FontSize="{StaticResource KioskFontSizeLabel}"
                                Style="{StaticResource KioskWhiteSemiBoldTextStyle}" />
                            <ComboBox
                                x:Name="ScannerPickerComboBox"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="HidScannerItem" Content="HID Barcode Scanner" />
                                <ComboBoxItem x:Name="KeyboardScannerItem" Content="Keyboard Mode" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource KioskSpacingSmall}">
                            <TextBlock
                                Text="Model"
                                FontSize="{StaticResource KioskFontSizeLabel}"
                                Style="{StaticResource KioskWhiteSemiBoldTextStyle}" />
                            <ComboBox
                                x:Name="ModelPickerComboBox"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource KioskSpacingSmall}">
                            <TextBlock
                                Text="Hardware"
                                FontSize="{StaticResource KioskFontSizeLabel}"
                                Style="{StaticResource KioskWhiteSemiBoldTextStyle}" />
                            <ComboBox
                                x:Name="HardwarePickerComboBox"
                                AutomationProperties.AutomationId="HardwarePickerComboBox"
                                AutomationProperties.Name="Hardware"
                                DisplayMemberPath="Name"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource KioskSpacingSmall}">
                            <TextBlock
                                Text="Camera"
                                FontSize="{StaticResource KioskFontSizeLabel}"
                                Style="{StaticResource KioskWhiteSemiBoldTextStyle}" />
                            <ComboBox
                                x:Name="CameraPickerComboBox"
                                DisplayMemberPath="DisplayName"
                                HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Button
                            Content="Edit Labels"
                            FontSize="{StaticResource KioskFontSizeButton}"
                            Background="{StaticResource KioskNeutralBrush}"
                            Padding="{StaticResource KioskCompactButtonPadding}"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource KioskControlButtonStyle}"
                            Click="OnEditLabelsClick" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
            <FontIcon Glyph="&#xE713;" FontSize="{StaticResource KioskFontSizeSubtitle}" />
        </Button>
        <Grid
            x:Name="LabelDialogOverlay"
            Background="{StaticResource KioskOverlayBrush}"
            Visibility="Collapsed">
            <Border
                Width="620"
                MaxHeight="620"
                Padding="{StaticResource KioskDialogPadding}"
                Style="{StaticResource KioskPanelBorderStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="Accepted Labels"
                        FontSize="{StaticResource KioskFontSizeDialogTitle}"
                        Margin="{StaticResource KioskDialogSectionMargin}"
                        Style="{StaticResource KioskWhiteBoldTextStyle}" />
                    <ItemsView
                        x:Name="LabelsItemsView"
                        Grid.Row="1"
                        MaxHeight="400"
                        SelectionMode="Multiple"
                        RequestedTheme="Dark"
                        AutomationProperties.Name="Accepted labels">
                        <ItemsView.Layout>
                            <UniformGridLayout
                                MinItemWidth="170"
                                MinRowSpacing="{StaticResource KioskSpacingSmall}"
                                MinColumnSpacing="{StaticResource KioskSpacingSmall}"
                                MaximumRowsOrColumns="3"
                                ItemsStretch="Fill" />
                        </ItemsView.Layout>
                        <ItemsView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <ItemContainer AutomationProperties.Name="{x:Bind}">
                                    <TextBlock Text="{x:Bind}" Margin="8"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource KioskWhiteBrush}" />
                                </ItemContainer>
                            </DataTemplate>
                        </ItemsView.ItemTemplate>
                    </ItemsView>
                    <StackPanel
                        Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="{StaticResource KioskSpacingMedium}"
                        Margin="{StaticResource KioskDialogActionsMargin}">
                        <Button
                            Content="Cancel"
                            Padding="{StaticResource KioskCompactButtonPadding}"
                            Background="{StaticResource KioskNeutralBrush}"
                            Style="{StaticResource KioskWhiteForegroundButtonStyle}"
                            Click="OnCancelLabelsClick" />
                        <Button
                            Content="Save"
                            Padding="{StaticResource KioskCompactButtonPadding}"
                            Background="{StaticResource KioskSuccessBrush}"
                            Style="{StaticResource KioskWhiteForegroundButtonStyle}"
                            Click="OnSaveLabelsClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
