<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="KioskPrimaryBrush" Color="#1E5799" />
    <SolidColorBrush x:Key="KioskSuccessBrush" Color="#28A745" />
    <SolidColorBrush x:Key="KioskDangerBrush" Color="#DC3545" />
    <SolidColorBrush x:Key="KioskFailureBrush" Color="#B00020" />
    <SolidColorBrush x:Key="KioskNeutralBrush" Color="#444444" />
    <SolidColorBrush x:Key="KioskPanelBrush" Color="#E0333333" />
    <SolidColorBrush x:Key="KioskOverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="KioskLoadingOverlayBrush" Color="#CC000000" />
    <SolidColorBrush x:Key="KioskWhiteBrush" Color="White" />
    <SolidColorBrush x:Key="KioskBlackBrush" Color="Black" />
    <SolidColorBrush x:Key="KioskErrorBrush" Color="Red" />
    <SolidColorBrush x:Key="KioskProgressBrush" Color="LightGray" />

    <x:Double x:Key="KioskFontSizeSmall">14</x:Double>
    <x:Double x:Key="KioskFontSizeButton">16</x:Double>
    <x:Double x:Key="KioskFontSizeLabel">18</x:Double>
    <x:Double x:Key="KioskFontSizeBodyLarge">20</x:Double>
    <x:Double x:Key="KioskFontSizeSubtitle">22</x:Double>
    <x:Double x:Key="KioskFontSizeDialogTitle">24</x:Double>
    <x:Double x:Key="KioskFontSizeList">25</x:Double>
    <x:Double x:Key="KioskFontSizeTitle">28</x:Double>
    <x:Double x:Key="KioskFontSizeSuccess">38</x:Double>
    <x:Double x:Key="KioskFontSizeHero">42</x:Double>

    <x:Double x:Key="KioskSpacingSmall">8</x:Double>
    <x:Double x:Key="KioskSpacingMedium">12</x:Double>
    <x:Double x:Key="KioskSpacingLarge">16</x:Double>
    <x:Double x:Key="KioskSpacingHero">32</x:Double>

    <Thickness x:Key="KioskPagePadding">32</Thickness>
    <Thickness x:Key="KioskPanelPadding">16</Thickness>
    <Thickness x:Key="KioskDialogPadding">20</Thickness>
    <Thickness x:Key="KioskLargeButtonPadding">48,16</Thickness>
    <Thickness x:Key="KioskHeroButtonPadding">40,14</Thickness>
    <Thickness x:Key="KioskActionButtonPadding">24,12</Thickness>
    <Thickness x:Key="KioskCompactButtonPadding">18,10</Thickness>
    <Thickness x:Key="KioskBackButtonPadding">16,8</Thickness>
    <Thickness x:Key="KioskBottomActionMargin">0,16,0,0</Thickness>
    <Thickness x:Key="KioskHeaderMargin">0,0,0,20</Thickness>
    <Thickness x:Key="KioskDialogSectionMargin">0,0,0,16</Thickness>
    <Thickness x:Key="KioskDialogActionsMargin">0,16,0,0</Thickness>
    <Thickness x:Key="KioskInferencePanelMargin">12</Thickness>
    <Thickness x:Key="KioskInferenceTextMargin">10,6</Thickness>

    <CornerRadius x:Key="KioskControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="KioskPanelCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="KioskRoundCornerRadius">26</CornerRadius>

    <Style x:Key="KioskWhiteBoldTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource KioskWhiteBrush}" />
    </Style>

    <Style x:Key="KioskWhiteSemiBoldTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource KioskWhiteBrush}" />
    </Style>

    <Style x:Key="KioskWhiteForegroundButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource KioskWhiteBrush}" />
    </Style>

    <Style
        x:Key="KioskWhiteButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource KioskWhiteForegroundButtonStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="KioskControlButtonStyle"
        TargetType="Button"
        BasedOn="{StaticResource KioskWhiteButtonStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource KioskControlCornerRadius}" />
    </Style>

    <Style x:Key="KioskPanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource KioskPanelBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource KioskPanelCornerRadius}" />
    </Style>

    <Style x:Key="KioskInferenceOverlayStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource KioskLoadingOverlayBrush}" />
    </Style>

    <Style
        x:Key="KioskInferenceTextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource KioskWhiteSemiBoldTextStyle}">
        <Setter Property="FontSize" Value="{StaticResource KioskFontSizeButton}" />
        <Setter Property="Margin" Value="{StaticResource KioskInferenceTextMargin}" />
    </Style>

    <Style x:Key="KioskScannedItemsListStyle" TargetType="ListBox">
        <Setter Property="FontSize" Value="{StaticResource KioskFontSizeList}" />
        <Setter Property="CornerRadius" Value="{StaticResource KioskPanelCornerRadius}" />
    </Style>

    <Style x:Key="KioskMismatchListStyle" TargetType="ListView">
        <Setter Property="Background" Value="{StaticResource KioskWhiteBrush}" />
        <Setter Property="Foreground" Value="{StaticResource KioskErrorBrush}" />
        <Setter Property="FontSize" Value="{StaticResource KioskFontSizeBodyLarge}" />
        <Setter Property="CornerRadius" Value="{StaticResource KioskPanelCornerRadius}" />
    </Style>
</ResourceDictionary>
